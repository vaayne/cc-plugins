{
  "name": "bb-plugin-workspace-navigator",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "description": "A Project → Worktree → Session sidebar for bb.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.4.3"
  },
  "bb": {
    "name": "Workspace Navigator",
    "description": "Find sessions by project and worktree, with status in place, pinned sessions, and provider usage.",
    "branding": {
      "icon": "FolderGit"
    },
    "app": "./app.tsx",
    "server": "./src/server.ts"
  },
  "keywords": [
    "bb-plugin",
    "sidebar",
    "worktree"
  ],
  "dependencies": {
    "zod": "4.3.6"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.9",
    "@types/node": "24.12.4",
    "@types/react": "19.2.13",
    "react": "19.2.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11"
  }
}
